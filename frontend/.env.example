# أوربيتا — إعدادات الواجهة

# false (الافتراضي) = ربط API الحقيقي عبر Vite proxy
# true = بيانات تجريبية + دخول وهمي بدون backend
VITE_USE_MOCK=false

# في وضع التطوير: إذا فشل الـ API، استخدم mock تلقائياً (بما فيها تسجيل الدخول)
VITE_FALLBACK_MOCK=true

# ── حسابات تجريبية (مع backend أو mock) ──
# أدمن:  07700000001 / Admin@123  → /admin
# عميل: 07700000002 / User@123   → /account
